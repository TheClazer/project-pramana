<?xml version="1.0" encoding="utf-8"?>
<!--
  Pramāṇa — AndroidManifest

  Required permissions per bible Section 9:
    CAMERA            - camera preview + ImageAnalysis + ImageCapture
    READ_MEDIA_IMAGES - Android 13+ scoped gallery access (Verify path)
    READ_MEDIA_VIDEO  - Android 13+ scoped gallery access (Verify path, future)

  Pre-Android-13 fallback:
    READ_EXTERNAL_STORAGE (maxSdkVersion=32) for older devices.

  No INTERNET permission. Bible Section 1: "no cloud, no telemetry, no data
  leakage." Privacy-first is part of the pitch — do NOT add network perms.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera (capture + analysis) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Android 13+ scoped media -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Pre-Android-13 fallback -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- StrongBox feature hint (informational only — code handles absence) -->
    <uses-feature
        android:name="android.hardware.strongbox_keystore"
        android:required="false" />

    <application
        android:name=".PramanaApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Pramana"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Pramana">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share-intent surface (bible Section 3 brief mapping) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
