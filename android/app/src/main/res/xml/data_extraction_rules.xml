<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ explicit data extraction rules. Same intent as backup_rules.xml:
  nothing is exfiltrated, even on device-transfer or cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
    </device-transfer>
</data-extraction-rules>
